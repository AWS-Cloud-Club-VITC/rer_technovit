# =======================================================
# Reverse Engineering Roulette (RER) - Environment Config
# =======================================================
# Copy this file to .env.local and fill in your credentials.
# Do NOT commit .env.local to version control.

# MongoDB Connection (Required)
MONGODB_URI=
MONGODB_DB=rer_technovit

# Supabase Storage Configuration (Required for PDF Submissions)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=rer-submissions

# Authentication Secret (Required for Session Signing)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=
